<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             x:Class="QpdfGui.App.Views.RepairView"
             x:DataType="tools:RepairViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Repair_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Repair_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 输入文件卡片 -->
            <controls:InputFileCard />

            <!-- 2. 优化配置选项卡片 -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Section_RepairConfig}" FontSize="14" FontWeight="SemiBold" />
                    <CheckBox IsChecked="{Binding Linearize}" Content="{DynamicResource Repair_Linearize}" />
                </StackPanel>
            </Border>

            <!-- 3. 输出保存位置 -->
            <controls:OutputCard />

            <!-- 4. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Repair_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
