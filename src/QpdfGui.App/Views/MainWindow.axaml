<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QpdfGui.App.ViewModels"
        xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
        xmlns:views="using:QpdfGui.App.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="QpdfGui.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QPDF GUI"
        Width="1060" Height="700"
        MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type tools:MergeViewModel}">
            <views:MergeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tools:SplitViewModel}">
            <views:SplitView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tools:EncryptViewModel}">
            <views:EncryptView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tools:DecryptViewModel}">
            <views:DecryptView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tools:RotateViewModel}">
            <views:RotateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tools:RepairViewModel}">
            <views:RepairView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <!-- 全局整体缩放容器（左栏与右栏协同缩放，水平垂直完全充满窗口） -->
    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>

        <Grid ColumnDefinitions="64,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- 左侧导航侧边栏（宽度 64px，宽 52 x 高 50 高亮居中，左右留白各 6px） -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    VerticalAlignment="Stretch">
                <Grid RowDefinitions="*,Auto">
                    <!-- 功能列表导航（超出时支持滚轮上下滑动，完全不显示滚动条） -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0,6,0,0"
                             HorizontalAlignment="Center"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ScrollBar">
                                <Setter Property="IsVisible" Value="False" />
                                <Setter Property="Width" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MaxWidth" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItem">
                                <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ic:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部设置入口（上下留白小且严格一致为 6px） -->
                    <Border Grid.Row="1" Margin="0,6,0,6" HorizontalAlignment="Center">
                        <Button Command="{Binding SelectSettingsCommand}"
                                Classes="CompactNavButton"
                                Classes.selected="{Binding IsSettingsSelected}"
                                Focusable="False">
                            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Settings" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧主工作区（包含顶部全局引擎引导条与主页面） -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- 极简单行引导条（高度紧凑，仅 36px，采用深浅模式自适应语义画刷） -->
                <Border Grid.Row="0"
                        IsVisible="{Binding EngineStatus.ShowEngineBanner}"
                        Background="{DynamicResource FeedbackWarningBackground}"
                        BorderBrush="{DynamicResource FeedbackWarningBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="16,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- 左侧图标与文案/进度 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource FeedbackWarningForeground}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Banner_EngineMissingPrompt}"
                                       FontSize="12" Foreground="{DynamicResource FeedbackWarningForeground}" VerticalAlignment="Center"
                                       IsVisible="{Binding !EngineStatus.IsDownloading}" />
                            <TextBlock Text="{Binding EngineStatus.DownloadStatusText}"
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource FeedbackWarningForeground}" VerticalAlignment="Center"
                                       IsVisible="{Binding EngineStatus.IsDownloading}" />
                        </StackPanel>

                        <!-- 中间进度条（仅在下载中展示） -->
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding EngineStatus.DownloadProgress}"
                                     Minimum="0" Maximum="1"
                                     Height="3" CornerRadius="1.5"
                                     Foreground="{DynamicResource FeedbackWarningForeground}" Background="{DynamicResource FeedbackWarningBorder}"
                                     Margin="16,0" VerticalAlignment="Center"
                                     IsVisible="{Binding EngineStatus.IsDownloading}" />

                        <!-- 右侧精简按钮组 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding EngineStatus.DownloadEngineCommand}"
                                    IsEnabled="{Binding !EngineStatus.IsDownloading}"
                                    Content="{DynamicResource Banner_DownloadAction}"
                                    FontWeight="Normal"
                                    Height="24" Padding="10,0" FontSize="11.5" />

                            <Button Command="{Binding EngineStatus.BrowseEnginePathCommand}"
                                    IsEnabled="{Binding !EngineStatus.IsDownloading}"
                                    Content="{DynamicResource Banner_BrowseAction}"
                                    FontWeight="Normal"
                                    Height="24" Padding="10,0" FontSize="11.5" />

                            <Button Command="{Binding EngineStatus.DismissBannerCommand}"
                                    IsVisible="{Binding !EngineStatus.IsDownloading}"
                                    Theme="{DynamicResource BorderlessButtonTheme}"
                                    Padding="4" Height="24" Width="24"
                                    ToolTip.Tip="关闭提示">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{DynamicResource FeedbackWarningForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主功能页面呈现容器 -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </LayoutTransformControl>
</Window>
