<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             xmlns:conv="using:QpdfGui.App.Converters"
             x:Class="QpdfGui.App.Views.RotateView"
             x:DataType="tools:RotateViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Rotate_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Rotate_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 输入文件卡片 -->
            <controls:InputFileCard />

            <!-- 2. 旋转参数设置卡片 -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Rotate_Angle}" FontSize="14" FontWeight="SemiBold" />

                    <!-- 旋转方向单选 -->
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton IsChecked="{Binding RotationAngle, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter='+90'}"
                                     Content="{DynamicResource Rotate_CW90}" />
                        <RadioButton IsChecked="{Binding RotationAngle, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter='-90'}"
                                     Content="{DynamicResource Rotate_CCW90}" />
                        <RadioButton IsChecked="{Binding RotationAngle, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter='+180'}"
                                     Content="{DynamicResource Rotate_180}" />
                    </StackPanel>

                    <!-- 作用页码范围 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Rotate_Range}" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" />
                        <TextBox Text="{Binding PageRange}" Classes="clearButton" />
                        <TextBlock Text="{DynamicResource Rotate_RangeHint}" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 输出保存位置 -->
            <controls:OutputCard />

            <!-- 4. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Rotate_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
