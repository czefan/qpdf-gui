<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             x:Class="QpdfGui.App.Views.DecryptView"
             x:DataType="tools:DecryptViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Decrypt_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Decrypt_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 输入文件卡片 -->
            <controls:InputFileCard />

            <!-- 2. 输出保存位置 -->
            <controls:OutputCard />

            <!-- 3. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Decrypt_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
