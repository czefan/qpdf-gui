<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="QpdfGui.App.Views.MergeView"
             x:DataType="tools:MergeViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 页面标题与描述 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Merge_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Merge_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 待合并文件列表卡片 -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{DynamicResource Section_InputList}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding AddFilesCommand}" Content="{DynamicResource Merge_AddFiles}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Command="{Binding ClearFilesCommand}" Content="{DynamicResource Merge_Clear}"
                                Theme="{DynamicResource BorderlessButtonTheme}" IsEnabled="{Binding Files.Count}" />
                    </Grid>

                    <!-- 未添加文件时的拖放提示热区 -->
                    <Border Classes="DropZone" IsVisible="{Binding !Files.Count}">
                        <Button Command="{Binding AddFilesCommand}" Classes="GhostDropZone">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="ArrowUpload" FontSize="30" Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{DynamicResource Input_DropHint}" FontSize="13.5" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 已添加文件的顺序列表 -->
                    <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding Files.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tools:MergeFileItem">
                                <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="6"
                                        Padding="12,8" Margin="0,3">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                        <!-- 文件序号徽章 [1], [2]... -->
                                        <Border Grid.Column="0" Background="{DynamicResource SemiColorFill1}" CornerRadius="4"
                                                Width="26" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index, StringFormat='[{0}]'}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- PDF 图标 -->
                                        <ic:SymbolIcon Grid.Column="1" Symbol="DocumentPdf" FontSize="24"
                                                       Foreground="{DynamicResource SemiColorPrimary}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <!-- 文件名与页数元数据 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13.5"
                                                       ToolTip.Tip="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding PageCount, StringFormat='共 {0} 页'}"
                                                           FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                                                <Border Background="{DynamicResource BadgeWarningBackground}" CornerRadius="4" Padding="5,1" IsVisible="{Binding IsEncrypted}">
                                                    <TextBlock Text="{DynamicResource Input_Encrypted}" FontSize="11" Foreground="{DynamicResource BadgeWarningForeground}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 单文件抽取页码范围 -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Spacing="8">
                                            <TextBlock Text="{DynamicResource Merge_PageRange}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" />
                                            <TextBox Text="{Binding PageRange}" Width="110" Classes="clearButton" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 排序与移除操作 -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Command="{Binding $parent[UserControl].((tools:MergeViewModel)DataContext).MoveUpCommand}"
                                                    CommandParameter="{Binding}" Padding="6,5"
                                                    Theme="{DynamicResource BorderlessButtonTheme}">
                                                <ic:SymbolIcon Symbol="ArrowUp" FontSize="14" />
                                            </Button>
                                            <Button Command="{Binding $parent[UserControl].((tools:MergeViewModel)DataContext).MoveDownCommand}"
                                                    CommandParameter="{Binding}" Padding="6,5"
                                                    Theme="{DynamicResource BorderlessButtonTheme}">
                                                <ic:SymbolIcon Symbol="ArrowDown" FontSize="14" />
                                            </Button>
                                            <Button Command="{Binding $parent[UserControl].((tools:MergeViewModel)DataContext).RemoveFileCommand}"
                                                    CommandParameter="{Binding}" Padding="6,5"
                                                    Theme="{DynamicResource BorderlessButtonTheme}">
                                                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. 高级编排表达式导入卡片（可选，单一真源：解析生成列表项） -->
            <Border Classes="ContentCard" IsVisible="{Binding Files.Count}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="BranchFork" FontSize="16" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Merge_CustomRule_Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Merge_CustomRule_Optional}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding MergeRuleExpression}"
                                 PlaceholderText="{DynamicResource Merge_ImportPlaceholder}"
                                 Classes="clearButton" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding ImportExpressionCommand}"
                                Content="{DynamicResource Merge_ImportExpression}"
                                Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 语法解析错误提示 -->
                    <Border Background="{DynamicResource BadgeDangerBackground}" CornerRadius="6" Padding="10,7"
                            IsVisible="{Binding HasMergeRuleError}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="DismissCircle" FontSize="14" Foreground="{DynamicResource BadgeDangerForeground}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MergeRuleError}" FontSize="12" Foreground="{DynamicResource BadgeDangerForeground}" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Merge_CustomRule_Tip}" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 3. 输出保存位置卡片 -->
            <controls:OutputCard />

            <!-- 4. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Merge_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
