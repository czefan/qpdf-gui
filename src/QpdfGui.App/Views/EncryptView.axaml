<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             x:Class="QpdfGui.App.Views.EncryptView"
             x:DataType="tools:EncryptViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Encrypt_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Encrypt_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 输入文件卡片 -->
            <controls:InputFileCard />

            <!-- 2. 加密参数与权限选项 -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Section_EncryptConfig}" FontSize="14" FontWeight="SemiBold" />

                    <!-- 密码设置行 -->
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Encrypt_UserPwd}" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding UserPassword}" PasswordChar="•"
                                 Classes="clearButton" PlaceholderText="{DynamicResource Encrypt_UserPwdHint}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Encrypt_OwnerPwd}" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding OwnerPassword}" PasswordChar="•"
                                 Classes="clearButton" PlaceholderText="{DynamicResource Encrypt_OwnerPwdHint}" />
                    </Grid>

                    <!-- 权限限制勾选 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Encrypt_PermTitle}" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding AllowPrinting}" Content="{DynamicResource Encrypt_AllowPrint}" Margin="0,0,0,6" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding AllowModification}" Content="{DynamicResource Encrypt_AllowModify}" Margin="0,0,0,6" />
                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding AllowExtraction}" Content="{DynamicResource Encrypt_AllowCopy}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AllowAnnotations}" Content="{DynamicResource Encrypt_AllowAnnot}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 输出保存位置 -->
            <controls:OutputCard />

            <!-- 4. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Encrypt_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
