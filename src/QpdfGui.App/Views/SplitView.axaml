<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:QpdfGui.App.ViewModels.Tools"
             xmlns:controls="using:QpdfGui.App.Views.Controls"
             xmlns:conv="using:QpdfGui.App.Converters"
             x:Class="QpdfGui.App.Views.SplitView"
             x:DataType="tools:SplitViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Split_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Split_Desc}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 输入文件卡片 -->
            <controls:InputFileCard />

            <!-- 2. 拆分模式选择卡片 -->
            <Border Classes="ContentCard">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Section_SplitOptions}" FontSize="14" FontWeight="SemiBold" />

                    <!-- 模式单选 -->
                    <StackPanel Spacing="10">
                        <!-- 模式 1：按固定页数连续切分 -->
                        <RadioButton IsChecked="{Binding Mode, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter={x:Static tools:SplitMode.FixedPages}}"
                                     Content="{DynamicResource Split_ModeFixed}" />
                        <StackPanel Margin="28,0,0,8" Spacing="8" IsVisible="{Binding IsFixedPagesMode}">
                            <Grid ColumnDefinitions="Auto,80,*" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Split_FixedCount}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FixedPagesCount}" Minimum="1" Maximum="10000" FormatString="0" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Split_BaseRange}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" Foreground="{DynamicResource SemiColorText1}" />
                                <TextBox Grid.Column="1" Text="{Binding FixedScopeRange}" Classes="clearButton" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Split_BaseRangeTip}" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>

                        <!-- 模式 2：按指定范围切分为多个文件 -->
                        <RadioButton IsChecked="{Binding Mode, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter={x:Static tools:SplitMode.SplitRanges}}"
                                     Content="{DynamicResource Split_ModeRange}" />
                        <StackPanel Margin="28,0,0,8" Spacing="6" IsVisible="{Binding IsSplitRangesMode}">
                            <TextBox Text="{Binding CustomRanges}" Classes="clearButton" />
                            <TextBlock Text="{DynamicResource Split_RangeTip}" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>

                        <!-- 模式 3：提取单个页码范围 -->
                        <RadioButton IsChecked="{Binding Mode, Converter={x:Static conv:EqualityToBoolConverter.Instance}, ConverterParameter={x:Static tools:SplitMode.ExtractSingle}}"
                                     Content="{DynamicResource Split_ModeExtract}" />
                        <StackPanel Margin="28,0,0,4" Spacing="6" IsVisible="{Binding IsExtractSingleMode}">
                            <TextBox Text="{Binding SingleExtractRange}" Classes="clearButton" />
                            <TextBlock Text="{DynamicResource Rotate_RangeHint}" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 输出保存位置 -->
            <controls:OutputCard />

            <!-- 4. 执行操作与状态区 -->
            <controls:RunPanel ActionContent="{DynamicResource Split_Start}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
